# Copy to .env and adjust. Never commit .env. Values below are local-development placeholders only.

# --- Backend (read by FastAPI; server side only) ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://brandpr:brandpr_dev_password@localhost:5432/brandpr
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=500
MAX_CSV_ROWS=50000
REVIEW_WARNING_DAYS=30

# --- docker compose (database container) ---
POSTGRES_USER=brandpr
POSTGRES_PASSWORD=brandpr_dev_password
POSTGRES_DB=brandpr

# --- Frontend ---
# Server side only: where Next.js proxies /api/* requests. Not exposed to the browser.
BACKEND_URL=http://localhost:8000
# Browser-visible and non-secret. Leave unset to use the same-origin /api proxy.
# NEXT_PUBLIC_API_BASE_URL=

# --- Phase 2: content review (server side only, never a NEXT_PUBLIC_ variable) ---
MAX_CONTENT_CHARS=20000
# Leave LLM_API_KEY empty to run the review engine in limited, deterministic-only mode (clearly labelled in every result).
# Set it to enable AI-assisted claim finding and paraphrase matching. Never commit a real key.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_SECONDS=45
# Optional JSON overriding default finding severities, keys "status:category" or "status:*".
# REVIEW_SEVERITY_OVERRIDES={"unsupported:comparative":"medium"}

# --- Phase 3: testing aid, leave at 0 ---
# Shifts only the date used by validity and expiry rules (never stored timestamps) so expiry can be exercised against a running
# server; scripts/e2e_fact_impacts.mjs starts a second backend with it set. The backend refuses to start in production if non-zero.
CLOCK_OFFSET_DAYS=0
